{%- liquid
	assign section_id             = '#shopify-section-' | append: section.id
	assign animation              = settings.section_animation
	assign columns                = section.settings.columns | default: 4
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	{{ section_id }} .vrworld-slider {
		--slide-size: 93%;
		--slide-spacing: var(--grid-horizontal);
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}

		{{ section_id }} .vrworld-slider {
			--slide-size: calc( 100% / {{ columns  }});
		}
	}
</style>

<div class="section-wrapper vr-featured-product-section color-{{ section.settings.color_scheme }}">
	<div class="{% if section.settings.full_width %}stretch-section{% else %}container{% endif %}">
		<div class="vr-featured-product-header">
			{%- if section.settings.heading != blank or section.settings.sub_heading != blank -%}
				<div class="title-wrapper">
					{%- if section.settings.heading != blank -%}
						<h2 class="heading rte {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
					{%- endif -%}
					{%- if section.settings.sub_heading != blank -%}
						<div class="sub-description rte">{{ section.settings.sub_heading }}</div>
					{%- endif -%}
				</div>
			{%- endif -%}

			{%- if section.settings.button_text != blank -%}
				<div class="section-button-wrapper">
					<a href="{{ section.settings.button_link | default: '#' }}" class="button {% if section.settings.button_style == 'gradient' %}gradient-button{% else %}{{ section.settings.button_style }}-button{% endif %}">
						{{ section.settings.button_text | escape }}
					</a>
				</div>
			{%- endif -%}
		</div>

		<vrworld-slider class="vrworld-slider">
			<template data-options>
				{
					{%- if section.settings.loop -%}
						"loop": true,
					{%- endif -%}

					{%- if section.settings.autoplay -%}
						"_autoplay": {{ section.settings.delay | times: 1000 }},
					{%- endif -%}

					"align": "start",
					"_autoheight": true,
					"_fade": false,
					"speed": 10,
					"_prevBtn": "{{ section_id }} .vrworld-button-prev",
					"_nextBtn": "{{ section_id }} .vrworld-button-next",
					"_dotsNode": "{{ section_id }} .vrworld-dots"
				}
			</template>

			<div class="vrworld-arrows active" data-index="1">
				<button class="vrworld-button vrworld-button-prev" title ="{{ 'general.vrworld.prev' | t }}-feature-prd" aria-label="{{ 'general.vrworld.prev' | t }}-feature-prd" id="{{ 'general.vrworld.prev' | t }}-feature-prd" aria-labelledby="{{ 'general.vrworld.prev' | t }}-feature-prd" disabled>
					{%- render 'icon', code: 'chevron-left' -%}
				</button>

				<button class="vrworld-button vrworld-button-next" title ="{{ 'general.vrworld.next' | t }}-feature-prd" aria-label="{{ 'general.vrworld.next' | t }}-feature-prd" id="{{ 'general.vrworld.next' | t }}-feature-prd" aria-labelledby="{{ 'general.vrworld.next' | t }}-feature-prd" disabled>
					{%- render 'icon', code: 'chevron-right' -%}
				</button>
			</div>

			<div class="vrworld-slider-viewport">
				<div class="vrworld-slider-container" data-id="{{ section.id }}" data-index="1">
					{%- assign collection = section.settings.collection -%}
					{%- assign total_items = section.settings.total_items | default: 4 -%}
					{%- for product in collection.products limit: total_items -%}
						<div class="vrworld-slide vr-featured-product-card">
							{%- render 'product-card', product: product, alignment: 'center' -%}
						</div>
					{%- else -%}
						{%- assign limit = section.settings.total_items | default: 4 -%}
						{%- for i in (1..limit) -%}
							<div class="vrworld-slide vr-featured-product-card">
								{%- render 'product-card-placeholder', index: i, alignment: 'center' -%}
							</div>
						{%- endfor -%}
					{%- endfor -%}
				</div>
			</div>

			{%- if section.settings.dots -%}
			<div class="align-dots-center">
				<div class="vrworld-dots active" data-index="1"></div>
			</div>
			{%- endif -%}
		</vrworld-slider>
	</div>
</div>

{% schema %}
{
	"name": "t:sections.vr-featured-product.name",
	"tag": "section",
	"class": "vr-featured-product-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-6"
		},
		{
			"type": "checkbox",
			"id": "full_width",
			"default": true,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "t:general.typography.heading.label",
			"default": "Featured Products"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h1",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "sub_heading",
			"label": "t:general.typography.sub_heading.label",
			"default": "<p>Select and customize your recommended products.</p>"
		},
		{
			"type": "select",
			"id": "text_align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "header",
			"content": "Section Button"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Explore Products",
			"label": "Button Label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "Button Link"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:general.typography.style.option_1.label"
				},
				{
					"value": "secondary",
					"label": "t:general.typography.style.option_2.label"
				},
				{
					"value": "gradient",
					"label": "Gradient button"
				}
			],
			"default": "primary",
			"label": "Button Style"
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "Collection"
		},
		{
			"type": "header",
			"content": "Slider Settings"
		},
		{
			"type": "range",
			"id": "columns",
			"min": 2,
			"max": 5,
			"step": 1,
			"default": 4,
			"label": "Columns on Desktop"
		},
		{
			"type": "range",
			"id": "total_items",
			"min": 2,
			"max": 5,
			"step": 1,
			"default": 4,
			"label": "Total items to show"
		},
		{
			"type": "checkbox",
			"id": "dots",
			"default": false,
			"label": "Show dots"
		},
		{
			"type": "checkbox",
			"id": "loop",
			"default": false,
			"label": "Loop"
		},
		{
			"type": "checkbox",
			"id": "autoplay",
			"default": false,
			"label": "Autoplay"
		},
		{
			"type": "range",
			"id": "delay",
			"min": 2,
			"max": 20,
			"step": 1,
			"default": 2,
			"unit": "s",
			"label": "Autoplay Delay"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 120,
			"step": 4,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 120,
			"step": 4,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"presets": [
		{
			"name": "t:sections.vr-featured-product.name"
		}
	]
}
{% endschema %}
