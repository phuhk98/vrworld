{%- liquid
	assign section_id             = '#shopify-section-' | append: section.id
	assign animation              = settings.section_animation
-%}

<style>
	{{ section_id }} .section-wrapper {
		padding-top: {{ section.settings.padding_top_mobile }}px;
		padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
	}

	@media (min-width: 992px) {
		{{ section_id }} .section-wrapper {
			padding-top: {{ section.settings.padding_top }}px;
			padding-bottom: {{ section.settings.padding_bottom }}px;
		}
	}
</style>

<div class="section-wrapper vr-featured-product-section color-{{ section.settings.color_scheme }}">
	<div class="{% if section.settings.full_width %}stretch-section{% else %}container{% endif %}">
		{%- if section.settings.heading != blank or section.settings.sub_heading != blank -%}
			<div class="container title-wrapper text-{{ section.settings.text_align }}">
				{%- if section.settings.sub_heading != blank -%}
					<div class="sub-heading rte">{{ section.settings.sub_heading }}</div>
				{%- endif -%}
				{%- if section.settings.heading != blank -%}
					<h2 class="heading rte {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
				{%- endif -%}
			</div>
		{%- endif -%}

		<div class="vr-featured-product-slider">
			<vrworld-slider class="vrworld-slider">
				<template data-options>
					{
						"dragFree": true,
						"align": "start",
						"containScroll": "trimSnaps",
						"_autoheight": true,
						"_fade": false
					}
				</template>
				<div class="vrworld-slider-viewport">
					<div class="vrworld-slider-container">
						{%- for block in section.blocks -%}
							{%- liquid
								assign product = all_products[block.settings.product]
							-%}
							<div class="vr-featured-product-slide vrworld-slide grid-item" {{ block.shopify_attributes }}>
								{%- if product != blank -%}
									{%- render 'product-card', product: product, alignment: 'center' -%}
								{%- else -%}
									{%- render 'product-card-placeholder', index: forloop.index, alignment: 'center' -%}
								{%- endif -%}
							</div>
						{%- else -%}
							{%- for i in (1..4) -%}
								<div class="vr-featured-product-slide vrworld-slide grid-item">
									{%- render 'product-card-placeholder', index: i, alignment: 'center' -%}
								</div>
							{%- endfor -%}
						{%- endfor -%}
					</div>
				</div>
			</vrworld-slider>
		</div>

		{%- if section.settings.button_text != blank -%}
			<div class="align-dots-center section-button-wrapper" style="margin-top: 4rem; display: flex; justify-content: center;">
				<a href="{{ section.settings.button_link | default: '#' }}" class="button {% if section.settings.button_style == 'gradient' %}gradient-button{% else %}{{ section.settings.button_style }}-button{% endif %}"{% if section.settings.button_style == 'gradient' %} style="background: var(--button-bg-gradient);"{% endif %}>
					{{ section.settings.button_text | escape }}
				</a>
			</div>
		{%- endif -%}
	</div>
</div>

{% schema %}
{
	"name": "VR Featured Product",
	"tag": "section",
	"class": "vr-featured-product-slider-section",
	"disabled_on": {
		"groups": ["header", "footer"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "t:settings_schema.colors.label",
			"default": "scheme-1"
		},
		{
			"type": "checkbox",
			"id": "full_width",
			"default": true,
			"label": "t:general.layout.full.label"
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "t:general.typography.heading.label",
			"default": "Featured Products"
		},
		{
			"type": "select",
			"id": "heading_size",
			"options": [
				{
					"value": "h3",
					"label": "t:general.typography.heading_size.option_1.label"
				},
				{
					"value": "h2",
					"label": "t:general.typography.heading_size.option_2.label"
				},
				{
					"value": "h1",
					"label": "t:general.typography.heading_size.option_3.label"
				}
			],
			"default": "h2",
			"label": "t:general.typography.heading_size.label"
		},
		{
			"type": "richtext",
			"id": "sub_heading",
			"label": "t:general.typography.sub_heading.label",
			"default": "<p>Select and customize your recommended products.</p>"
		},
		{
			"type": "select",
			"id": "text_align",
			"options": [
				{
					"value": "left",
					"label": "t:general.layout.alignment.option_1.label"
				},
				{
					"value": "center",
					"label": "t:general.layout.alignment.option_2.label"
				},
				{
					"value": "right",
					"label": "t:general.layout.alignment.option_3.label"
				}
			],
			"default": "center",
			"label": "t:general.layout.alignment.label"
		},
		{
			"type": "header",
			"content": "Section Button"
		},
		{
			"type": "text",
			"id": "button_text",
			"default": "Explore Products",
			"label": "Button Label"
		},
		{
			"type": "url",
			"id": "button_link",
			"label": "Button Link"
		},
		{
			"type": "select",
			"id": "button_style",
			"options": [
				{
					"value": "primary",
					"label": "t:general.typography.style.option_1.label"
				},
				{
					"value": "secondary",
					"label": "t:general.typography.style.option_2.label"
				},
				{
					"value": "gradient",
					"label": "Gradient button"
				}
			],
			"default": "primary",
			"label": "Button Style"
		},
		{
			"type": "header",
			"content": "t:general.padding.header_padding.content"
		},
		{
			"type": "range",
			"id": "padding_top",
			"min": 0,
			"max": 120,
			"step": 4,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom",
			"min": 0,
			"max": 120,
			"step": 4,
			"default": 40,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		},
		{
			"type": "paragraph",
			"content": "t:general.padding.paragraph_mobile.content"
		},
		{
			"type": "range",
			"id": "padding_top_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.top.label"
		},
		{
			"type": "range",
			"id": "padding_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 2,
			"default": 20,
			"unit": "px",
			"label": "t:general.padding.bottom.label"
		}
	],
	"blocks": [
		{
			"type": "product_item",
			"name": "Product Item",
			"settings": [
				{
					"type": "product",
					"id": "product",
					"label": "Product"
				}
			]
		}
	],
	"presets": [
		{
			"name": "VR Featured Product",
			"blocks": [
				{
					"type": "product_item"
				},
				{
					"type": "product_item"
				},
				{
					"type": "product_item"
				},
				{
					"type": "product_item"
				}
			]
		}
	]
}
{% endschema %}
